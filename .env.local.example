# ─────────────────────────────────────────────────────────────
# MouthOS Clinical Atlas — environment template
# Copy this file to .env.local and fill in real values:
#   cp .env.local.example .env.local
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Project URL — Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable anon key (safe in the browser). Required by the
# deployment contract even though all search traffic goes server-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses RLS — server-side only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini ────────────────────────────────────────────
# https://aistudio.google.com/apikey — server-side only.
GEMINI_API_KEY=your-gemini-api-key

# ── Optional retrieval tuning ────────────────────────────────
# Defaults to gemini-embedding-001 (3072 dims). Must match the model used
# to embed the documents in Supabase, and the vector(...) column size.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# MATCH_THRESHOLD=0.5
# MATCH_COUNT=5

# Optional image assessment model (must support images and structured JSON).
# Defaults to gemini-3.5-flash; uses the same server-side GEMINI_API_KEY.
# GEMINI_VISION_MODEL=gemini-3.5-flash
